# Copy to .env and fill in values. Never commit .env.

# --- Database (local docker-compose defaults shown in docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
TEST_DATABASE_URL=

# --- Backend auth ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=
COOKIE_SECURE=
COOKIE_SAMESITE=

# --- CORS: the frontend origin, e.g. http://localhost:3000 ---
FRONTEND_ORIGIN=

# --- Uploads ---
MAX_UPLOAD_MB=

# --- AI column mapping (optional; fuzzy fallback is used when empty) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Seeding demo users ---
DEMO_FINANCE_PASSWORD=
DEMO_FOUNDER_PASSWORD=

# --- Frontend (put these in frontend/.env.local; Next.js reads env files from its own folder) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_MODE=
