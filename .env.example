# Copy to .env and fill in values. Never commit .env.
# Local defaults are documented in README.md; production values in deployment.md.

# --- Database (local docker-compose; production: Neon) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
TEST_DATABASE_URL=

# --- Backend auth ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=
COOKIE_SECURE=
COOKIE_SAMESITE=

# --- Backend: CORS (frontend origin(s), comma-separated), docs, uploads, rules ---
FRONTEND_ORIGIN=
ENABLE_DOCS=
MAX_UPLOAD_MB=
UPLOAD_DIR=
RETURN_RECEIPT_DAYS=

# --- AI column mapping (optional; fuzzy fallback is used when empty) ---
GEMINI_API_KEY=
# Default gemini-3.1-flash-lite (gemini-2.5-flash returns 404 for new keys)
GEMINI_MODEL=
# low | medium | high; leave empty for models without a thinking setting
GEMINI_THINKING_LEVEL=

# --- Seeding demo users ---
DEMO_FINANCE_PASSWORD=
DEMO_FOUNDER_PASSWORD=

# --- Frontend (put these in frontend/.env.local; Next.js reads env files from its own folder) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_MODE=
# Proxy mode only: the backend URL that /api/* is forwarded to (then NEXT_PUBLIC_API_URL=/api)
BACKEND_URL=
